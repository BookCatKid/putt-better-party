{
  "name": "putt-better-party",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "test": "bun test",
    "prepare:client": "python3 scripts/prepare-client.py",
    "capture:client": "python3 scripts/capture-client.py",
    "backup": "python3 scripts/backup.py create",
    "backup:prune": "python3 scripts/backup.py prune",
    "release:check": "python3 scripts/release.py check",
    "release:archive": "python3 scripts/release.py archive",
    "format": "prettier --write . && ruff format scripts",
    "format:check": "prettier --check . && ruff format --check scripts",
    "lint": "eslint . --max-warnings 0 && ruff check scripts && shellcheck tests/integration/*.sh",
    "lint:fix": "eslint . --fix && ruff check scripts --fix",
    "check": "bun run prepare:client && bun run format:check && bun run lint && bun run typecheck && bun test",
    "test:browser": "bash tests/integration/run-browser-test.sh",
    "test:catalog": "bun tests/integration/check-live-catalog.mjs",
    "test:recovery": "bun tests/integration/check-recovery.mjs",
    "test:protocol": "bun tests/integration/check-room-lifecycle.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.snippets.json",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "precommit": "lint-staged && bun run prepare:client && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.4",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "{src,scripts,tests}/**/*.{js,mjs,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "{src,scripts,tests,docs,.github}/**/*.{css,html,json,md,yml,yaml}": "prettier --write",
    "eslint.config.js": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "{README.md,AGENTS.md,TODO.md,package.json,tsconfig.json}": "prettier --write",
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ],
    "*.sh": "shellcheck"
  }
}
